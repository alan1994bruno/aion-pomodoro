# Informa ao editor que este é o arquivo de configuração raiz e ele deve parar de procurar em pastas superiores
root = true

# Aplica essas regras a todos os arquivos
[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Regras específicas para arquivos Markdown
[*.md]
trim_trailing_whitespace = false